# Copy this file to .env and fill in your values.
# Everything marked REQUIRED must be set or the corresponding feature is disabled.

# ─── Core (REQUIRED) ──────────────────────────────────────────────────────────

# Database — Railway PostgreSQL connection string.
# If unset, the backend falls back to a local JSON file at backend/data/events.json.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Auth — JWT signing secret
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=your_long_random_secret_here

# Server port (Railway sets this automatically)
PORT=3001

# ─── Scheduler ────────────────────────────────────────────────────────────────

# What time to send the daily reminder push notifications (24h, server local time)
SEND_HOUR=9
SEND_MINUTE=0

# ─── Instagram Login (optional) ───────────────────────────────────────────────
# From developers.facebook.com → your app → Instagram Business Login.
# Without these, the "Continue with Instagram" button will fail.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Any string you choose; must match what you enter in the Meta webhook config.
INSTAGRAM_VERIFY_TOKEN=your_webhook_verify_token

# ─── Password reset via email (optional) ──────────────────────────────────────
# Resend (resend.com). Without these, email password reset silently no-ops.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=CelebConnect <noreply@yourdomain.com>

# ─── Password reset via SMS (optional) ────────────────────────────────────────
# Twilio. Used when the account was created with a phone number instead of email.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550001111

# ─── Profile photo uploads (optional) ─────────────────────────────────────────
# Cloudinary. Without these, profile photo upload is disabled.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Error monitoring (optional) ──────────────────────────────────────────────
SENTRY_DSN=

# ─── WhatsApp Business Cloud API (optional, NOT used for personal greetings) ──
#
# ⚠️  The app does NOT auto-send greetings through this API, and must not.
#     Meta's Business Messaging Policy requires explicit prior opt-in from each
#     recipient; sending unsolicited personal greetings gets the number
#     restricted or permanently disabled.
#
#     CelebConnect instead sends the OWNER a push notification, and the owner
#     taps once to send from their own personal WhatsApp. These variables exist
#     only for the legacy backend/whatsapp.js helper, which is not wired into
#     the scheduler. Leave them blank unless you know exactly why you need them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PRODUCTION=false

# ─── One-off migration helper ─────────────────────────────────────────────────
# Events created before per-user ownership existed have no owner and are hidden
# from everyone. Set this to your user id and restart once to claim them, then
# remove it.
ADOPT_ORPHAN_EVENTS_USER_ID=

# ─── Mobile app (set in the Expo dashboard, not here) ─────────────────────────
# EXPO_PUBLIC_BACKEND_URL=https://celebconnect-production.up.railway.app
